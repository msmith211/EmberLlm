<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>EmberLlm</RootNamespace>
    <PackageId>EmberLlm</PackageId>
    <Description>A .NET client for local LLM servers (LM Studio, Ollama, llama.cpp, vLLM), built on Microsoft.Extensions.AI: server discovery, streaming chat with separate reasoning, and errors and timeouts suited to local hardware.</Description>
    <PackageTags>llm;local-llm;ollama;lm-studio;llama.cpp;vllm;openai;ai;microsoft-extensions-ai</PackageTags>
    <!-- Missing XML docs on public members (CS1591) fail the build via TreatWarningsAsErrors -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- nuget.org can't resolve the repo README's relative links, so the package has its own -->
  <ItemGroup>
    <None Include="PackageReadme.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EmberLlm.Tests" />
  </ItemGroup>

</Project>
